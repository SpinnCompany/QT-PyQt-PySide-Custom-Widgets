                    "Theme-name": "Headline Light",
                    "Default-Theme": false,
                    "Create-icons": false,
                    "Background-color": "#f6f5fa",
                    "Text-color": "#1e1a30",
                    "Accent-color": "#5b21b6",
                    "Icons-color": "#6b7280",
                    "Other-variables": {
                        "SURFACE": "#ffffff",
