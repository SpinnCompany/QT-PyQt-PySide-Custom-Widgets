                {
                    "Theme-name": "Picker Light",
                    "Default-Theme": false,
                    "Create-icons": false,
                    "Background-color": "#f6f5fb",
                    "Text-color": "#201c33",
                    "Accent-color": "#6d28d9",
                    "Icons-color": "#6b7280",
                    "Other-variables": {
                        "SURFACE": "#ffffff",
                        "OUTLINE": "#d9d6e8",
