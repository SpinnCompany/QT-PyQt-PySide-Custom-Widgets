{
    "ShowLogs": true,
    "QtBinding": "PySide6",
    "LiveCompileQss": true,
    "CheckForMissingicons": true,
    "QMainWindow": {
        "title": "Cash Flow — Dashboard"
    },
    "QSettings": {
        "AppSettings": {
            "OrganizationName": "Custom Widgets",
            "ApplicationName": "CashFlowDashboard",
            "OrganizationDomain": "spinncode.com"
        },
        "ThemeSettings": {
            "QtDesignerIconsColor": "theme",
            "CustomThemes": [
                {
                    "Theme-name": "Cashflow Light",
                    "Default-Theme": true,
                    "Create-icons": true,
                    "Background-color": "#ffffff",
                    "Text-color": "#0f1b18",
                    "Accent-color": "#16a34a",
                    "Icons-color": "#8b93a1"
                },
                {
                    "Theme-name": "Cashflow Dark",
                    "Default-Theme": false,
                    "Create-icons": true,
                    "Background-color": "#0e1512",
                    "Text-color": "#e8efe9",
                    "Accent-color": "#2ee06a",
                    "Icons-color": "#9aa7a0"
                }
            ],
            "Fonts": {
                "_comment": "Remote web font — downloaded + cached + registered by the theme engine (Custom_Widgets.Utils.download_font). No bundling required.",
                "LoadFonts": [
                    { "name": "Inter", "url": "https://cdn.jsdelivr.net/gh/rsms/inter@master/docs/font-files/InterVariable.ttf" }
                ],
                "DefaultFont": { "name": "Inter", "size": 10 }
            }
        }
    },
    "_comment_ChartPalette": "Read in code by gui/theme.py — every data-viz / painted hue lives WITH the theme so it flips on theme switch (token-driven, no hard-coded hex in Python).",
    "ChartPalette": {
        "Cashflow Light": {
            "bannerTop": "#0f4a43",
            "bannerBottom": "#0b302b",
            "bannerText": "#ffffff",
            "bannerMuted": "#9fc4bd",

            "accent": "#16a34a",
            "accentText": "#ffffff",

            "pos": "#16a34a",
            "neg": "#e5484d",

            "barIncome": "#123f39",
            "barExpense": "#34d17a",
            "gridLine": "#e6e9ec",

            "cardTop": "#0f4a43",
            "cardBottom": "#0a2b27",
            "cardStrip": "#2ee06a",
            "cardGradients": [
                ["#0f5a50", "#0a2f2a"],
                ["#6d4bd0", "#3a2472"],
                ["#f0873f", "#c9531f"]
            ],

            "chipBg": "#e6f7ee",
            "chipText": "#16a34a",

            "successBg": "#e6f7ee",
            "successText": "#16a34a",
            "pendingBg": "#eef0f2",
            "pendingText": "#8b93a1",

            "kpiIconBg": "#10403a",
            "kpiIconFg": "#ffffff",

            "divider": "#edeff2",
            "muted": "#8b93a1",
            "text": "#0f1b18",

            "segBg": "#f1f3f5",
            "segActiveBg": "#ffffff",
            "segActiveText": "#0f1b18",

            "popupBg": "#ffffff",
