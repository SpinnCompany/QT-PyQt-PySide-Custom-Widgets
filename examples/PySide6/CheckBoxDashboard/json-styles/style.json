{
    "ShowLogs": true,
    "QtBinding": "PySide6",
    "LiveCompileQss": true,
    "CheckForMissingicons": true,
    "QMainWindow": {
        "title": "Check Box — Dashboard"
    },
    "QSettings": {
        "AppSettings": {
            "OrganizationName": "Custom Widgets",
            "ApplicationName": "CheckBoxDashboard",
            "OrganizationDomain": "spinncode.com"
        },
        "ThemeSettings": {
            "QtDesignerIconsColor": "theme",
            "CustomThemes": [
                {
                    "Theme-name": "CheckBox Dark",
                    "Default-Theme": true,
                    "Create-icons": true,
                    "Background-color": "#1c1c20",
                    "Text-color": "#f4f5f7",
                    "Accent-color": "#9fe870",
                    "Icons-color": "#c9cbd1"
                },
                {
                    "Theme-name": "CheckBox Light",
                    "Default-Theme": false,
                    "Create-icons": true,
                    "Background-color": "#ffffff",
                    "Text-color": "#15161a",
                    "Accent-color": "#4fb02a",
                    "Icons-color": "#5b5d66"
                }
            ],
            "Fonts": {
                "_comment": "Remote web font — downloaded + cached + registered by the theme engine. No bundling required.",
                "LoadFonts": [
                    { "name": "Inter", "url": "https://cdn.jsdelivr.net/gh/rsms/inter@master/docs/font-files/InterVariable.ttf" }
                ],
                "DefaultFont": { "name": "Inter", "size": 10 }
            }
        }
    },
    "_comment_ChartPalette": "Read in code by gui/theme.py — every painted / data-viz hue lives WITH the theme so it flips on theme switch (no hard-coded hex in Python).",
    "ChartPalette": {
        "CheckBox Dark": {
            "shell": "#0c0c0e",
            "card": "#161619",
            "cardInner": "#1d1d21",
            "text": "#f4f5f7",
            "muted": "#8b8d96",
            "faint": "#2a2a30",

            "green": "#9fe870",
            "orange": "#f6912b",
            "white": "#ffffff",
            "onColorText": "#15161a",
            "onOrangeText": "#ffffff",

            "accent": "#9fe870",
            "accentText": "#15161a",

            "pillBg": "#1d1d21",
            "pillText": "#f4f5f7",
            "pillMuted": "#8b8d96",

            "searchBg": "#1d1d21",
            "badge": "#ff4d4f",

            "gridLine": "#2a2a30",
            "beeswarmLine": "#33333a",
            "dotEmpty": "#2a2a30",

            "railBg": "#141417",
            "railIcon": "#c9cbd1",
            "railActive": "#9fe870"
        },
        "CheckBox Light": {
            "shell": "#f2f3f5",
            "card": "#ffffff",
            "cardInner": "#f4f6f8",
            "text": "#15161a",
            "muted": "#6b6d76",
            "faint": "#e5e7eb",

            "green": "#7bc94a",
            "orange": "#f0873f",
            "white": "#2a2c33",
            "onColorText": "#15161a",
            "onOrangeText": "#ffffff",

            "accent": "#4fb02a",
            "accentText": "#ffffff",

            "pillBg": "#ffffff",
            "pillText": "#15161a",
            "pillMuted": "#6b6d76",

            "searchBg": "#ffffff",
            "badge": "#ff4d4f",

            "gridLine": "#e5e7eb",
            "beeswarmLine": "#d7dae0",
            "dotEmpty": "#dfe2e7",

            "railBg": "#ffffff",
            "railIcon": "#5b5d66",
            "railActive": "#4fb02a"
        }
    }
}
